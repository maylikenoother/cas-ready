# Copy this file to .env.local for local development.
# Never commit real keys. NEXT_PUBLIC_ values are visible in the browser.
# CLERK_SECRET_KEY, CLERK_WEBHOOK_SIGNING_SECRET, and SUPABASE_SERVICE_ROLE_KEY stay on the server.

# Public site URL. Used for Stripe return links. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk. Development instance: https://boss-minnow-9913.clerk.accounts.dev
# Copy the keys from the Clerk dashboard. Leave these empty in the repo.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/home
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/home

# Supabase project. Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only. Project Settings → API → service_role.
# Used for webhooks, scoring writes, retention, and account deletion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini. Create a key in Google AI Studio.
# The key stays on the server. The browser never sees it.
GEMINI_API_KEY=
# Change the model without a code change. Free-tier default is Gemini 2.5 Flash.
GEMINI_MODEL=gemini-2.5-flash
# free: Google may use prompts to improve its products.
# paid: set this after you enable billing on the Google project.
# Google's paid Gemini API terms say prompts and responses are not used for training.
# Switching tier is this variable plus billing on the Google account. No code change.
GEMINI_TIER=free
# Optional. Leave as the default unless Google gives you a different API host.
GEMINI_API_BASE=https://generativelanguage.googleapis.com

# stripe today. paystack and flutterwave are reserved and will not charge anyone yet.
BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe, test mode, recurring monthly.
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_READY=price_...

# Leave blank until those providers are implemented.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# Protects the daily retention job. Send Authorization: Bearer this value.
CRON_SECRET=choose-a-long-random-string

# Days before a recording and transcript are cleared. Scores can remain.
RETENTION_DAYS=90
